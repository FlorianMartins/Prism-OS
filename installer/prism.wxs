<?xml version="1.0" encoding="utf-8"?>
<!--
  Installateur MSI de Prism OS (WiX Toolset 5, sur le Windows de la CI) :
    wix build -arch x64 -culture fr-FR -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
              -d Version=0.7.2 -d Bin=target\release -o prism.msi installer\prism.wxs
  Assistant : bienvenue, licence, CHOIX DU DOSSIER, installation, fin avec « Lancer
  Prism ». Mise à jour en place (même UpgradeCode). À la désinstallation, chaque réglage
  changé par Prism est remis (« prism desinstaller ») avant de retirer les fichiers.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Prism OS" Language="1036" Codepage="1252" Version="$(var.Version)"
           Manufacturer="Hivey" UpgradeCode="9655d7b5-c281-4a1e-8947-4baf353c50f5"
           Scope="perMachine" InstallerVersion="500">
    <SummaryInformation Description="Prism OS — couche gaming et cybersécurité pour Windows" />
    <MajorUpgrade DowngradeErrorMessage="Une version plus récente de Prism OS est déjà installée." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/FlorianMartins/Prism-OS" />
    <Property Id="ARPCOMMENTS" Value="Désinstaller remet chaque réglage changé par Prism." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Prism">
        <Component Id="Core">
          <File Id="PrismExe" Source="$(var.Bin)\prism.exe" KeyPath="yes" />
          <File Id="PrismBarExe" Source="$(var.Bin)\prism-bar.exe" />
          <File Id="PrismUiExe" Source="$(var.Bin)\prism-ui.exe" />
          <File Id="License" Name="LICENCE.txt" Source="LICENSE" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenu">
        <Shortcut Id="PrismUiShortcut" Name="Prism" Description="Prism OS : tableau de bord et réglages"
                  Target="[INSTALLFOLDER]prism-ui.exe" WorkingDirectory="INSTALLFOLDER" />
        <!-- Désinstallation visible dans le menu Démarrer (en plus d'« Applications installées »). -->
        <Shortcut Id="PrismUninstallShortcut" Name="Désinstaller Prism"
                  Description="Remet tout comme avant Prism et retire le programme"
                  Target="[System64Folder]msiexec.exe" Arguments="/x [ProductCode]" />
        <RegistryValue Root="HKLM" Key="Software\Prism OS" Name="InstallFolder" Type="string"
                       Value="[INSTALLFOLDER]" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Prism OS">
      <ComponentRef Id="Core" />
      <ComponentRef Id="StartMenu" />
    </Feature>

    <!-- Assistant avec choix du dossier. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="installer\licence.rtf" />

    <!-- Fin de l'assistant : case « Lancer Prism » (cochée), lancement en tant qu'utilisateur. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Lancer Prism" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#PrismUiExe]" />
    <CustomAction Id="LaunchPrism" DllEntry="WixShellExec" BinaryRef="Wix4UtilCA_X64" Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchPrism"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <!-- Après l'installation (compte SYSTEM) : dossier ajouté au PATH ; l'appli n'est
         ouverte par cette action que pour une installation sans assistant (UILevel < 5),
         sinon c'est la case « Lancer Prism » qui s'en charge ; PRISM_SETUP=1 : lancé par
         Prism-Setup.exe, qui propose lui-même « Lancer Prism » à la fin. -->
    <CustomAction Id="PrismAfterInstall" FileRef="PrismExe" ExeCommand="apres-installation [LogonUser] [UILevel] [PRISM_SETUP]"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <!-- Désinstallation (pas une mise à jour) : tout remettre comme avant, sans fenêtre. -->
    <CustomAction Id="PrismCleanup" FileRef="PrismExe" ExeCommand="desinstaller [LogonUser]"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="PrismAfterInstall" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="PrismCleanup" After="InstallInitialize"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
